rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    match /apps/{appId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /settings/config {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /auditLogs/{logId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
