# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- Google AI Studio Environment Variables ---

# 1. JWT_SECRET: Strong 32-byte cryptographic secret for signing admin session tokens
JWT_SECRET="f0b9ecf73c52e14e7c757a084c30689bd368194650a52b91452a411fefbef5a9"

# 2. STORAGE_PROVIDER: Exact provider driver value
STORAGE_PROVIDER="cloudflare_r2"

# 3. STORAGE_BUCKET: Your actual Cloudflare R2 bucket name
STORAGE_BUCKET="smilestore-apks"

# 4. STORAGE_REGION: Always 'auto' for Cloudflare R2
STORAGE_REGION="auto"

# 5. STORAGE_ENDPOINT: https://<YOUR_ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_ENDPOINT="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"

# 6. STORAGE_ACCESS_KEY: Your Cloudflare R2 Access Key ID
STORAGE_ACCESS_KEY="YOUR_R2_ACCESS_KEY_ID"

# 7. STORAGE_SECRET_KEY: Your Cloudflare R2 Secret Access Key
STORAGE_SECRET_KEY="YOUR_R2_SECRET_ACCESS_KEY"

# 8. CDN_URL: Leave blank for now (optional)
CDN_URL=""

# 9. WEB_URL: Leave blank for now (optional)
WEB_URL=""


